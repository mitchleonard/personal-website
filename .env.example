# Ice Cream Shoppe private counter (Supabase Auth + Postgres only)
# Image/video files remain in Vercel Blob via BLOB_READ_WRITE_TOKEN.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SHOPPE_EDITOR_EMAIL=

# Future Anthropic chatbot integration
ANTHROPIC_API_KEY=

# Contact form email delivery (Resend — resend.com)
# 1. Sign up free at https://resend.com
# 2. Add & verify your domain (mitchleonard.com)
# 3. Create an API key and paste it here
# 4. Update the `from` address in app/api/contact/route.ts to use your verified domain
RESEND_API_KEY=
